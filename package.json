{
  "name": "melodymath",
  "private": true,
  "description": "Hebrew math practice and graph sonification — no install, no backend",
  "scripts": {
    "test": "node --test",
    "coverage": "node tools/codecov.js",
    "test:pilot": "npm --prefix pilot test",
    "check:circular": "madge --circular --extensions js src pilot/js",
    "check:assets": "node tools/check-assets.js",
    "knip": "knip",
    "size": "size-limit",
    "check:html": "node tools/check-html.js",
    "doctor": "node tools/doctor.js",
    "check:sw": "node tools/check-sw.js",
    "check:a11y-static": "node tools/check-a11y-static.js",
    "check:i18n": "node tools/check-i18n.js"
  },
  "devDependencies": {
    "@size-limit/file": "14.3.0",
    "knip": "6.45.1",
    "madge": "8.0.0",
    "size-limit": "14.3.0"
  }
}
